# StepFun API key — required. Both standard API and Step Plan (token-plan)
# subscriptions use the same STEPFUN_API_KEY env var.
STEPFUN_API_KEY=sk-...

# Optional: override the base URL. Leave unset to use the surface default
# (see `surface` in plugins.entries.stepfun-vision.config).
# Standard API (CN):    https://api.stepfun.com/v1
# Standard API (INTL):  https://api.stepfun.ai/v1
# Step Plan   (CN):     https://api.stepfun.com/step_plan/v1   <- token-plan subscribers
# Step Plan   (INTL):   https://api.stepfun.ai/step_plan/v1
# STEPFUN_BASE_URL=

# Optional: image detail level passed in image_url blocks ("low" | "high").
# STEPFUN_IMAGE_DETAIL=high
